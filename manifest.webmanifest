{
 "name": "Link Stash",
 "short_name": "Link Stash",
 "description": "Save and search links by category",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#fdf7fb",
 "theme_color": "#fdf7fb",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./",
  "method": "GET",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url"
  }
 }
}